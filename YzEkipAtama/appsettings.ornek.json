{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5080",

  // Yetki kontrolü (AuthHelper / DokuPanel). YetkiKontrolu = true ise Windows kimliği alınır ve DokuPanel'de
  // CurrentSiteName için tanımlı grup/kişi listesine bakılır. false ise sayfa herkese açıktır.
  "AppSettings": {
    "YetkiKontrolu": false,
    "CurrentSiteName": "YzEkipAtama",
    "DokuPanelApiUrl": "http://localhost/DokuPanel/api/config/get-groups-by-name?siteName=",
    "DokuPanelKey": "",
    // Yetki sonucu kullanıcı başına bu kadar dakika önbellekte tutulur (sayfa sık sık durum sorduğu için)
    "YetkiOnbellekDakika": 10
  },

  "YzAyarlari": {
    // OpenAI uyumlu chat/completions adresinin TAMAMI (model Qwen olmasa da ad aynı kalır)
    "QwenApiUrl": "https://YYYYY.zt.ai.aaaa.bbbb/v1/chat/XXXXXX",
    "QwenApiKey": "",
    "AiModel": "zt-ga-small-0",
    "Temperature": 0.1,
    // Yanıt için en fazla token. Düşünen modellerde (Qwen3) <think> bölümü de buna dahildir.
    // 0 = sınır gönderilmez (sunucu varsayılanı)
    "MaksToken": 8000,
    // Artık JSON değil EKIP:/GUVEN:/GEREKCE: satırları isteniyor; bunu açmayın
    "JsonModu": false,
    // Qwen3 gibi düşünen modellerde <think> bölümünü kapatır: istekte chat_template_kwargs.enable_thinking=false
    // gönderilir ve mesaja /no_think eklenir. Sunucu bu alanı tanımayıp HTTP 400 verirse false yapın.
    "DusunmeyiKapat": true,
    "ZamanAsimiDakika": 5,
    "SertifikaDogrulamasiniAtla": true,
    // Aynı anda modele gönderilecek satır sayısı
    "Paralellik": 3,
    // Hatalı, biçimsiz veya katalogda olmayan ekip içeren yanıtta toplam deneme sayısı
    "DenemeSayisi": 3,
    // false: ön eleme yok, her maddede 114 ekibin tamamı TÜM servisleriyle gider
    //        (prompt uzar, modelin bağlam penceresi yetmeli; AdayEkipSayisi ve EkipBasinaServisSayisi yok sayılır)
    // true : anahtar kelime benzerliğiyle en olası AdayEkipSayisi ekip, en ilgili EkipBasinaServisSayisi servisiyle gider
    "OnElemeYap": false,
    "AdayEkipSayisi": 20,
    // 0 = ekibin tüm servisleri
    "EkipBasinaServisSayisi": 12,
    // Bir madde için önerilebilecek en fazla ekip sayısı
    "MaksEkipSayisi": 3,
    // Katalogdaki servis açıklamaları modele gönderilsin mi? Prompt'u en çok bu büyütür:
    // 576 servis x 250 karakter yaklaşık 50-60 bin token eder. Bağlam yetmezse karakteri düşürün veya OnElemeYap'ı açın.
    "ServisAciklamasiGonder": true,
    // Her servis açıklamasından gönderilecek en fazla karakter (0 = tamamı)
    "ServisAciklamaMaksKarakter": 250,
    // Prosedür listesi yüklüyse her maddeyle en ilgili kaç prosedür modele gönderilsin (0 = gönderme)
    "IlgiliProsedurSayisi": 15,
    // Adı genel olduğu için her işi kendine çeken ekipler: yalnızca işin kendisi YZ geliştirme/işletme ise sorumlu yapılır
    "GenelAdliEkipler": [ "YAPAY ZEKA UYGULAMALARI" ],
    // Prompt'a eklenen kurum kuralları; {EKİP ADI} yazılan yer ekibin [E...] koduyla değiştirilir. Yeni kural ekleyebilirsiniz.
    "EkKurallar": [
      "YALNIZCA maddenin ASIL KONUSU iş birimi talebinin alınması/takibi (Pergel), proje kapsamının belirlenmesi, paydaşların projeye dahil edilmesi veya proje iletişimi ise Sorumlu ekip {STRATEJİK PLANLAMA ve KOORDİNASYON} olur. Risk, uyum, hukuk, güvenlik, veri, model, altyapı, test, eğitim, denetim gibi konularda bu kuralı UYGULAMA; o konuların sahibi ekibi seç (bu ekibi sırf maddede 'süreç', 'koordinasyon' veya 'planlama' geçtiği için seçme)."
    ]
  },

  // Servis kataloğu veritabanından okunur (BaglantiMetni zorunlu).
  // Açılışta otomatik okunur; sayfadaki "Veritabanından yenile" ile tekrar okunabilir.
  "KatalogVeritabani": {
    // Windows kimlik doğrulaması örneği:
    "BaglantiMetni": "Server=SQLSUNUCU;Database=SM9PROD;Integrated Security=True;TrustServerCertificate=True",
    "Tablo": "[SM9PROD].[dbo].[ZTSERVISKATALOGUM1]",
    // İsteğe bağlı WHERE koşulu (WHERE yazmadan). Sayfadaki "Kayıt durumları" listesine bakarak doldurun, ör:
    // "Filtre": "DURUM = 'Aktif' AND RECORD_ACTIVE = 1"
    "Filtre": "",
    // Doluysa Tablo/Filtre yerine bu sorgu çalışır (SERVIS_ADI, SERVIS_SAHIBI_BOLUM zorunlu; SERVIS_KODU, YONETICILER,
    // SERVIS_KATEGORISI, SERVIS_ACIKLAMASI isteğe bağlı)
    "Sorgu": "",
    "ZamanAsimiSaniye": 60
  },

  // Prosedür listesi veritabanından okunur (BaglantiMetni zorunlu). Durum = False olanlar atlanır.
  "ProsedurVeritabani": {
    "BaglantiMetni": "Server=SQLSUNUCU;Database=doku;Integrated Security=True;TrustServerCertificate=True",
    "Tablo": "[doku].[dbo].[prosedur]",
    "Filtre": "",
    "Sorgu": "",
    "ZamanAsimiSaniye": 60
  },

  "ExcelAyarlari": {
    // Kullanıcının kendi doldurduğu kolonlar: modele yalnızca ipucu olarak gider
    "KullaniciEkipKolonu": "E",
    "KullaniciNotKolonu": "F",
    "CiktiEkipBasligi": "YZ Önerilen Ekipler ve Görevleri",
    "CiktiGerekceBasligi": "YZ Karar Gerekçesi",
    // Prosedür listesi yüklüyse sonuç Excel'ine eklenen üçüncü kolon
    "CiktiProsedurBasligi": "YZ İlgili Mevcut Prosedürler",
    // Kontrol hücresinde birden fazla madde varsa (-, •, 1., a) veya alt alta satırlar) her biri ayrı değerlendirilir
    "HucreMaddeleriniAyir": true,
    // Ekiplere ek görev tanımı: ad katalogdaki ekiple eşleşirse tanım o ekibe eklenir, eşleşmezse katalog dışı yeni ekip olarak eklenir
    "KatalogaEklenecekEkipler": [
      {
        "Ad": "STRATEJİK PLANLAMA ve KOORDİNASYON",
        "Aciklama": "Talep ve proje koordinasyonu: iş birimlerinden gelen taleplerin Pergel uygulaması üzerinden alınması ve takibi, proje kapsamının belirlenmesi ve kapsam değişiklikleri, paydaşların belirlenmesi ve projeye dahil edilmesi, paydaş/proje iletişimi."
      }
    ]
  }
}
