{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5080",

  "YzAyarlari": {
    // OpenAI uyumlu chat/completions adresinin TAMAMI (model Qwen olmasa da ad aynı kalır)
    "QwenApiUrl": "https://YYYYY.zt.ai.aaaa.bbbb/v1/chat/XXXXXX",
    "QwenApiKey": "",
    "AiModel": "zt-ga-small-0",
    "Temperature": 0.1,
    // Yanıt için en fazla token. Düşünen modellerde (Qwen3) <think> bölümü de buna dahildir.
    // 0 = sınır gönderilmez (sunucu varsayılanı)
    "MaksToken": 8000,
    // Artık JSON değil EKIP:/GUVEN:/GEREKCE: satırları isteniyor; bunu açmayın
    "JsonModu": false,
    // Qwen3 gibi düşünen modellerde <think> bölümünü kapatır: istekte chat_template_kwargs.enable_thinking=false
    // gönderilir ve mesaja /no_think eklenir. Sunucu bu alanı tanımayıp HTTP 400 verirse false yapın.
    "DusunmeyiKapat": true,
    "ZamanAsimiDakika": 5,
    "SertifikaDogrulamasiniAtla": true,
    // Aynı anda modele gönderilecek satır sayısı
    "Paralellik": 3,
    // Hatalı, biçimsiz veya katalogda olmayan ekip içeren yanıtta toplam deneme sayısı
    "DenemeSayisi": 3,
    // false: ön eleme yok, her maddede 114 ekibin tamamı TÜM servisleriyle gider
    //        (prompt uzar, modelin bağlam penceresi yetmeli; AdayEkipSayisi ve EkipBasinaServisSayisi yok sayılır)
    // true : anahtar kelime benzerliğiyle en olası AdayEkipSayisi ekip, en ilgili EkipBasinaServisSayisi servisiyle gider
    "OnElemeYap": false,
    "AdayEkipSayisi": 20,
    // 0 = ekibin tüm servisleri
    "EkipBasinaServisSayisi": 12,
    // Bir madde için önerilebilecek en fazla ekip sayısı
    "MaksEkipSayisi": 3,
    // Katalogdaki servis açıklamaları modele gönderilsin mi? Prompt'u en çok bu büyütür:
    // 576 servis x 250 karakter yaklaşık 50-60 bin token eder. Bağlam yetmezse karakteri düşürün veya OnElemeYap'ı açın.
    "ServisAciklamasiGonder": true,
    // Her servis açıklamasından gönderilecek en fazla karakter (0 = tamamı)
    "ServisAciklamaMaksKarakter": 250,
    // Prosedür listesi yüklüyse her maddeyle en ilgili kaç prosedür modele gönderilsin (0 = gönderme)
    "IlgiliProsedurSayisi": 15,
    // Adı genel olduğu için her işi kendine çeken ekipler: yalnızca işin kendisi YZ geliştirme/işletme ise sorumlu yapılır
    "GenelAdliEkipler": [ "YAPAY ZEKA UYGULAMALARI" ]
  },

  "ExcelAyarlari": {
    // Kullanıcının kendi doldurduğu kolonlar: modele yalnızca ipucu olarak gider
    "KullaniciEkipKolonu": "E",
    "KullaniciNotKolonu": "F",
    "CiktiEkipBasligi": "YZ Önerilen Ekipler ve Görevleri",
    "CiktiGerekceBasligi": "YZ Karar Gerekçesi",
    // Servis kataloğunda açıklama kolonu: başlığında "Açıklama" geçen kolon aranır, yoksa bu harf kullanılır
    "KatalogAciklamaKolonu": "F",
    // Prosedür listesi yüklüyse sonuç Excel'ine eklenen üçüncü kolon
    "CiktiProsedurBasligi": "YZ İlgili Mevcut Prosedürler",
    // Prosedür listesinde "Doküman Adı" / "Süreç Sahibi Birim" başlıkları bulunamazsa kullanılacak kolonlar
    "ProsedurAdKolonu": "D",
    "ProsedurBirimKolonu": "H",
    // Kontrol hücresinde birden fazla madde varsa (-, •, 1., a) veya alt alta satırlar) her biri ayrı değerlendirilir
    "HucreMaddeleriniAyir": true,
    // Katalogda olmayan ama kurumda var olan ekipler; görev tanımlarıyla birlikte katalogdaymış gibi modele gönderilir
    "KatalogaEklenecekEkipler": [
      {
        "Ad": "PROJE YÖNETİMİ OFİSİ",
        "Aciklama": "Kurum genelinde proje yönetimi ofisi (PMO): proje başlatma ve onay süreçleri, proje planlama, kaynak ve bütçe takibi, proje portföy yönetimi, proje yönetişimi, kilometre taşı ve risk takibi, proje durum raporlaması, ekip görevlendirme koordinasyonu."
      }
    ]
  }
}
