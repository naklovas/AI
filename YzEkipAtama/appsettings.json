{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5080",

  "YzAyarlari": {
    // OpenAI uyumlu chat/completions adresinin TAMAMI (model Qwen olmasa da ad aynı kalır)
    "QwenApiUrl": "https://YYYYY.zt.ai.aaaa.bbbb/v1/chat/XXXXXX",
    "QwenApiKey": "",
    "AiModel": "zt-ga-small-0",
    "Temperature": 0.1,
    // 0 = sunucu varsayılanı
    "MaksToken": 1500,
    // true: istekte response_format = json_object gönderilir (sunucu destekliyorsa açın)
    "JsonModu": false,
    "ZamanAsimiDakika": 3,
    "SertifikaDogrulamasiniAtla": true,
    // Aynı anda modele gönderilecek satır sayısı
    "Paralellik": 3,
    // Ayrıştırılamayan / hatalı yanıtta toplam deneme sayısı
    "DenemeSayisi": 2,
    // Prompt'a servis listesiyle birlikte konulacak en olası aday ekip sayısı.
    // 0 = 114 ekibin tamamı tüm servisleriyle gider (modelin bağlam penceresi büyükse)
    "AdayEkipSayisi": 20,
    "EkipBasinaServisSayisi": 12,
    // Bir madde için önerilebilecek en fazla ekip sayısı
    "MaksEkipSayisi": 3
  },

  "ExcelAyarlari": {
    // Kullanıcının kendi doldurduğu kolonlar: modele yalnızca ipucu olarak gider
    "KullaniciEkipKolonu": "E",
    "KullaniciNotKolonu": "F",
    "CiktiEkipBasligi": "YZ Önerilen Ekipler ve Görevleri",
    "CiktiGerekceBasligi": "YZ Karar Gerekçesi"
  }
}
